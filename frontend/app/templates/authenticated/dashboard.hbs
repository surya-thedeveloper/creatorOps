<div class="space-y-8">
  {{! Greeting }}
  <div>
    <h2 class="text-2xl font-bold text-text">Welcome back!</h2>
    <p class="text-sm text-text-secondary mt-1">Here is a quick snapshot of your
      content operations workspace.</p>
  </div>

  {{! KPI Stats Grid }}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {{! Total Content Card }}
    <div
      class="bg-card border border-border p-6 rounded-2xl shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow"
    >
      <div>
        <span
          class="text-xs font-semibold text-text-secondary tracking-wider uppercase block"
        >Total Content</span>
        <span
          class="text-3xl font-extrabold text-text mt-2 block"
        >{{this.model.summary.totalContent}}</span>
      </div>
      <div class="mt-4 flex items-center gap-1.5 text-xs text-text-secondary">
        <span
          class="font-medium text-emerald-600"
        >{{this.model.summary.publishedContent}}</span>
        published
        <span class="mx-1">•</span>
        <span
          class="font-medium text-indigo-600"
        >{{this.model.summary.scheduledContent}}</span>
        scheduled
      </div>
    </div>

    {{! Assignments Card }}
    <div
      class="bg-card border border-border p-6 rounded-2xl shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow"
    >
      <div>
        <span
          class="text-xs font-semibold text-text-secondary tracking-wider uppercase block"
        >Team Assignments</span>
        <span
          class="text-3xl font-extrabold text-text mt-2 block"
        >{{this.model.summary.totalAssignments}}</span>
      </div>
      <div class="mt-4 flex items-center gap-1.5 text-xs text-text-secondary">
        <span
          class="font-medium text-orange-600"
        >{{this.model.summary.activeAssignments}}</span>
        active tasks
      </div>
    </div>

    {{! Tasks Checklist Card }}
    <div
      class="bg-card border border-border p-6 rounded-2xl shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow"
    >
      <div>
        <span
          class="text-xs font-semibold text-text-secondary tracking-wider uppercase block"
        >Tasks Completed</span>
        <span
          class="text-3xl font-extrabold text-text mt-2 block"
        >{{this.model.summary.completedTasks}}
          <span class="text-lg font-normal text-text-secondary">/
            {{this.model.summary.totalTasks}}</span></span>
      </div>
      <div class="mt-4 flex items-center gap-1.5 text-xs text-text-secondary">
        {{#if this.model.summary.overdueTasks}}
          <span
            class="font-semibold text-red-600"
          >{{this.model.summary.overdueTasks}} overdue tasks</span>
        {{else}}
          <span class="font-medium text-emerald-600">All tasks on schedule</span>
        {{/if}}
      </div>
    </div>

    {{! Assets Card }}
    <div
      class="bg-card border border-border p-6 rounded-2xl shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow"
    >
      <div>
        <span
          class="text-xs font-semibold text-text-secondary tracking-wider uppercase block"
        >Assets Tracked</span>
        <span
          class="text-3xl font-extrabold text-text mt-2 block"
        >{{this.model.summary.totalAssets}}</span>
      </div>
      <div class="mt-4 flex items-center gap-1.5 text-xs text-text-secondary">
        Uploaded files & raw footage
      </div>
    </div>
  </div>

  {{! Brands Section }}
  <div
    class="bg-card border border-border rounded-2xl shadow-sm overflow-hidden"
  >
    <div
      class="px-6 py-5 border-b border-border flex items-center justify-between"
    >
      <h3 class="text-base font-bold text-text">Your Brands / Channels</h3>
      <LinkTo
        @route="setup.brand"
        class="text-xs font-semibold text-primary hover:text-primary-hover flex items-center gap-1"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4v16m8-8H4"
          />
        </svg>
        Add brand
      </LinkTo>
    </div>

    <div class="divide-y divide-border">
      {{#each this.model.brands as |brand|}}
        <div
          class="p-6 flex items-center justify-between hover:bg-gray-50 transition-colors"
        >
          <div class="flex items-center gap-4">
            <div
              class="h-12 w-12 rounded-xl bg-gray-100 border border-border flex items-center justify-center font-bold text-lg text-text-secondary overflow-hidden"
            >
              {{#if brand.logoUrl}}
                <img
                  src={{brand.logoUrl}}
                  alt={{brand.name}}
                  class="h-full w-full object-cover"
                />
              {{else}}
                {{first-char brand.name}}
              {{/if}}
            </div>
            <div>
              <span
                class="font-bold text-text text-sm block"
              >{{brand.name}}</span>
              <span
                class="text-xs text-text-secondary mt-1 block max-w-md truncate"
              >{{brand.description}}</span>
            </div>
          </div>

          {{#if this.session.orgId}}
            <LinkTo
              @route="authenticated.org.brand.content"
              @models={{array this.session.orgId brand.id}}
              class="inline-flex items-center gap-1.5 px-4 py-2 border border-border rounded-lg text-xs font-semibold text-text-secondary hover:bg-white hover:text-text hover:shadow-sm transition-all"
            >
              Open Workspace
              <svg
                class="h-3.5 w-3.5 text-text-secondary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </LinkTo>
          {{/if}}
        </div>
      {{else}}
        <div class="p-12 text-center">
          <div
            class="h-12 w-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto text-text-secondary"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              />
            </svg>
          </div>
          <h4 class="mt-4 text-sm font-bold text-text">No brands found</h4>
          <p class="text-xs text-text-secondary mt-1">Create a brand to begin
            planning content boards.</p>
          <LinkTo
            @route="setup.brand"
            class="mt-4 inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-xs font-semibold text-white bg-primary hover:bg-primary-hover focus:outline-none transition-colors"
          >
            Create first brand
          </LinkTo>
        </div>
      {{/each}}
    </div>
  </div>
</div>