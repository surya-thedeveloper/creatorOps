<div
  class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 overflow-hidden"
>
  <div
    class="bg-card border border-border rounded-2xl shadow-xl w-full max-w-5xl h-[85vh] flex flex-col overflow-hidden"
  >
    {{! Modal Header }}
    <div
      class="px-8 py-5 border-b border-border flex items-center justify-between flex-shrink-0"
    >
      <div>
        <div class="flex items-center gap-2">
          <span
            class="text-[10px] font-bold tracking-wider px-2 py-0.5 rounded-md uppercase bg-primary/10 text-primary"
          >
            {{this.model.content.type}}
          </span>
          <span
            class="text-xs text-text-secondary"
          >#{{this.model.content.id}}</span>
        </div>
        <h3
          class="font-bold text-text text-lg mt-1"
        >{{this.model.content.title}}</h3>
      </div>
      <button
        type="button"
        class="text-text-secondary hover:text-text cursor-pointer text-lg font-bold"
        {{on "click" this.closeModal}}
      >
        ✕
      </button>
    </div>

    {{! Tab Bar }}
    <div
      class="px-8 border-b border-border flex gap-4 flex-shrink-0 bg-gray-50/50 overflow-x-auto"
    >
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'overview')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "overview")}}
      >
        Overview
      </button>
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'research')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "research")}}
      >
        Research & AI
      </button>
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'script')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "script")}}
      >
        Script Drafts
      </button>
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'assignments')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "assignments")}}
      >
        Assignments
      </button>
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'tasks')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "tasks")}}
      >
        Checklist Tasks
      </button>
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'assets')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "assets")}}
      >
        Assets Links
      </button>
      <button
        type="button"
        class="py-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer
          {{if
            (eq this.activeTab 'activity')
            'border-primary text-primary'
            'border-transparent text-text-secondary hover:text-text'
          }}"
        {{on "click" (fn this.changeTab "activity")}}
      >
        Activity Log
      </button>
    </div>

    {{! Modal Body Content Split }}
    <div class="flex-grow flex overflow-hidden">
      {{! Main Left Tab Content (Scrollable) }}
      <div class="flex-grow overflow-y-auto p-8">
        {{#if (eq this.activeTab "overview")}}
          <form class="space-y-6" {{on "submit" this.saveOverview}}>
            <div class="space-y-4">
              <div>
                <label
                  for="edit-title"
                  class="block text-xs font-semibold text-text uppercase tracking-wider"
                >Title</label>
                <input
                  id="edit-title"
                  type="text"
                  required
                  class="mt-1.5 block w-full px-4 py-2.5 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none transition-all"
                  value={{this.editTitle}}
                  {{on "input" (pick "target.value" (mut this.editTitle))}}
                />
              </div>

              <div>
                <label
                  for="edit-desc"
                  class="block text-xs font-semibold text-text uppercase tracking-wider"
                >Description</label>
                <textarea
                  id="edit-desc"
                  rows="4"
                  class="mt-1.5 block w-full px-4 py-2.5 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none transition-all"
                  value={{this.editDescription}}
                  {{on
                    "input"
                    (pick "target.value" (mut this.editDescription))
                  }}
                ></textarea>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label
                    for="edit-stage"
                    class="block text-xs font-semibold text-text uppercase tracking-wider"
                  >Workflow Stage</label>
                  <select
                    id="edit-stage"
                    class="mt-1.5 block w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none transition-all"
                    value={{this.editStage}}
                    {{on "change" (pick "target.value" (mut this.editStage))}}
                  >
                    {{#each this.stages as |stage|}}
                      <option value={{stage}}>{{stage}}</option>
                    {{/each}}
                  </select>
                </div>

                <div>
                  <label
                    for="edit-priority"
                    class="block text-xs font-semibold text-text uppercase tracking-wider"
                  >Priority</label>
                  <select
                    id="edit-priority"
                    class="mt-1.5 block w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none transition-all"
                    value={{this.editPriority}}
                    {{on
                      "change"
                      (pick "target.value" (mut this.editPriority))
                    }}
                  >
                    {{#each this.priorities as |priority|}}
                      <option value={{priority}}>{{priority}}</option>
                    {{/each}}
                  </select>
                </div>
              </div>

              <div>
                <label
                  for="edit-due-date"
                  class="block text-xs font-semibold text-text uppercase tracking-wider"
                >Due Date</label>
                <input
                  id="edit-due-date"
                  type="date"
                  class="mt-1.5 block w-full px-4 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none transition-all"
                  value={{this.editDueDate}}
                  {{on "input" (pick "target.value" (mut this.editDueDate))}}
                />
              </div>
            </div>

            <div
              class="pt-4 border-t border-border flex items-center justify-between"
            >
              <button
                type="button"
                class="px-4 py-2 border border-red-200 text-red-700 hover:bg-red-50 text-xs font-semibold rounded-lg transition-colors cursor-pointer"
                {{on "click" this.deleteCard}}
              >
                Delete Content Card
              </button>
              <button
                type="submit"
                disabled={{this.isSaving}}
                class="px-4 py-2 bg-primary hover:bg-primary-hover disabled:opacity-50 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors cursor-pointer"
              >
                Save Details
              </button>
            </div>
          </form>
        {{/if}}

        {{#if (eq this.activeTab "research")}}
          <div class="space-y-6">
            {{! AI Brainstorm Trigger }}
            <div
              class="bg-indigo-50 border border-indigo-100 p-6 rounded-xl flex items-center justify-between"
            >
              <div>
                <h4 class="font-bold text-sm text-indigo-900">AI Brainstorm
                  Engine</h4>
                <p class="text-xs text-indigo-700 mt-1">Generate click hooks,
                  visual themes, and outline structures using Gemini API.</p>
              </div>
              <button
                type="button"
                disabled={{this.isGeneratingAi}}
                class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-xs font-semibold rounded-lg transition-colors shadow-sm cursor-pointer"
                {{on "click" this.triggerAiBrainstorm}}
              >
                {{if
                  this.isGeneratingAi
                  "Analyzing..."
                  "Trigger AI Brainstorm"
                }}
              </button>
            </div>

            {{! Notes and Link creation form grid }}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {{! Add Note }}
              <form
                class="p-5 border border-border bg-gray-50 rounded-xl space-y-3"
                {{on "submit" this.addNote}}
              >
                <h4
                  class="font-bold text-xs text-text uppercase tracking-wider"
                >Add Note Card</h4>
                <input
                  type="text"
                  required
                  placeholder="Note Title"
                  class="block w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text outline-none focus:ring-1 focus:ring-primary transition-all"
                  value={{this.newNoteTitle}}
                  {{on "input" (pick "target.value" (mut this.newNoteTitle))}}
                />
                <textarea
                  rows="3"
                  required
                  placeholder="Write observation here..."
                  class="block w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text outline-none focus:ring-1 focus:ring-primary transition-all"
                  value={{this.newNoteText}}
                  {{on "input" (pick "target.value" (mut this.newNoteText))}}
                ></textarea>
                <button
                  type="submit"
                  class="px-3 py-1.5 bg-primary hover:bg-primary-hover text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer"
                >Save Note</button>
              </form>

              {{! Add Link }}
              <form
                class="p-5 border border-border bg-gray-50 rounded-xl space-y-3"
                {{on "submit" this.addLink}}
              >
                <h4
                  class="font-bold text-xs text-text uppercase tracking-wider"
                >Add Reference Link</h4>
                <input
                  type="text"
                  required
                  placeholder="Source Description (e.g. Reddit Thread)"
                  class="block w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text outline-none focus:ring-1 focus:ring-primary transition-all"
                  value={{this.newLinkTitle}}
                  {{on "input" (pick "target.value" (mut this.newLinkTitle))}}
                />
                <input
                  type="url"
                  required
                  placeholder="https://example.com/source"
                  class="block w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text outline-none focus:ring-1 focus:ring-primary transition-all"
                  value={{this.newLinkUrl}}
                  {{on "input" (pick "target.value" (mut this.newLinkUrl))}}
                />
                <button
                  type="submit"
                  class="px-3 py-1.5 bg-primary hover:bg-primary-hover text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer"
                >Save Link</button>
              </form>
            </div>

            {{! List of Research items }}
            <div class="space-y-4">
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Research Items</h4>
              <div class="space-y-3">
                {{#each this.model.researchItems as |item|}}
                  <div
                    class="p-4 border border-border rounded-xl shadow-sm bg-card"
                  >
                    <div class="flex items-center justify-between mb-2">
                      <span
                        class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase
                          {{if
                            (eq item.type 'NOTE')
                            'bg-yellow-50 text-yellow-800 border border-yellow-200'
                          }}
                          {{if
                            (eq item.type 'LINK')
                            'bg-blue-50 text-blue-800 border border-blue-200'
                          }}
                          {{if
                            (eq item.type 'AI_BRAINSTORM')
                            'bg-indigo-50 text-indigo-800 border border-indigo-200'
                          }}"
                      >
                        {{item.type}}
                      </span>
                      <span
                        class="text-[10px] text-text-secondary"
                      >{{item.createdAt}}</span>
                    </div>
                    <span
                      class="font-bold text-sm text-text block"
                    >{{item.title}}</span>
                    {{#if item.contentText}}
                      <p
                        class="text-xs text-text-secondary mt-2 whitespace-pre-wrap"
                      >{{item.contentText}}</p>
                    {{/if}}
                    {{#if item.externalUrl}}
                      <a
                        href={{item.externalUrl}}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-primary hover:underline font-semibold flex items-center gap-1 mt-2"
                      >
                        Open link Reference
                        <svg
                          class="h-3 w-3"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                      </a>
                    {{/if}}
                  </div>
                {{else}}
                  <p class="text-xs text-text-secondary italic">No research
                    items linked yet.</p>
                {{/each}}
              </div>
            </div>
          </div>
        {{/if}}

        {{#if (eq this.activeTab "script")}}
          <div class="space-y-6">
            {{! AI Script Generation Trigger }}
            <div
              class="bg-indigo-50 border border-indigo-100 p-6 rounded-xl flex items-center justify-between"
            >
              <div>
                <h4 class="font-bold text-sm text-indigo-900">AI Script Drafting</h4>
                <p class="text-xs text-indigo-700 mt-1">Generate a full script
                  draft from your research notes via Google Gemini.</p>
              </div>
              <button
                type="button"
                disabled={{this.isGeneratingAi}}
                class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-xs font-semibold rounded-lg transition-colors shadow-sm cursor-pointer"
                {{on "click" this.triggerAiScript}}
              >
                {{if
                  this.isGeneratingAi
                  "Drafting..."
                  "Trigger AI Script Generation"
                }}
              </button>
            </div>

            {{! Scripts draft list and active editor }}
            <div class="space-y-4">
              {{#each this.model.scripts as |script|}}
                <div
                  class="border border-border rounded-xl p-6 bg-card flex flex-col space-y-4 shadow-sm"
                >
                  <div
                    class="flex items-center justify-between border-b border-border pb-3"
                  >
                    <div>
                      <span
                        class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase bg-gray-100 border border-border"
                      >
                        {{script.documentType}}
                      </span>
                      <span
                        class="text-xs text-text-secondary ml-2 font-medium"
                      >Version {{script.version}}</span>
                    </div>
                    <button
                      type="button"
                      class="px-3 py-1.5 bg-primary hover:bg-primary-hover text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer"
                      {{on "click" (fn this.saveScriptText script)}}
                    >
                      Save Version
                    </button>
                  </div>

                  {{! Text editor integration }}
                  <textarea
                    rows="15"
                    class="block w-full p-4 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none transition-all font-mono whitespace-pre-wrap leading-relaxed"
                    placeholder="Write script content here..."
                    value={{script.editorContent}}
                    {{on
                      "input"
                      (pick "target.value" (mut script.editorContent))
                    }}
                  ></textarea>
                </div>
              {{else}}
                <p class="text-xs text-text-secondary italic">No scripts created
                  yet. Use AI Drafting to start.</p>
              {{/each}}
            </div>
          </div>
        {{/if}}

        {{#if (eq this.activeTab "assignments")}}
          <div class="space-y-6">
            {{! Create Assignment form }}
            <form
              class="p-5 border border-border bg-gray-50 rounded-xl space-y-4"
              {{on "submit" this.createAssignment}}
            >
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Assign Contributor</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label
                    for="assign-user"
                    class="block text-xs text-text-secondary font-medium mb-1"
                  >Select User</label>
                  <select
                    id="assign-user"
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.assignUserId}}
                    {{on
                      "change"
                      (pick "target.value" (mut this.assignUserId))
                    }}
                  >
                    <option value="">Select User...</option>
                    {{#each this.usersList as |user|}}
                      <option value={{user.id}}>{{user.fullName}}
                        ({{user.email}})</option>
                    {{else}}
                      <option value="" disabled>User listing not available in
                        Phase 1</option>
                    {{/each}}
                  </select>
                </div>

                <div>
                  <label
                    for="assign-role"
                    class="block text-xs text-text-secondary font-medium mb-1"
                  >Assignment Role</label>
                  <select
                    id="assign-role"
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.assignRole}}
                    {{on "change" (pick "target.value" (mut this.assignRole))}}
                  >
                    <option value="RESEARCH">RESEARCH</option>
                    <option value="SCRIPT">SCRIPT</option>
                    <option value="PRODUCTION">PRODUCTION</option>
                    <option value="EDITING">EDITING</option>
                    <option value="REVIEW">REVIEW</option>
                    <option value="PUBLISHING">PUBLISHING</option>
                    <option value="OTHER">OTHER</option>
                  </select>
                </div>
              </div>

              <div>
                <label
                  for="assign-notes"
                  class="block text-xs text-text-secondary font-medium mb-1"
                >Brief Instructions</label>
                <input
                  id="assign-notes"
                  type="text"
                  placeholder="e.g. Please draft this script by Friday"
                  class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                  value={{this.assignNotes}}
                  {{on "input" (pick "target.value" (mut this.assignNotes))}}
                />
              </div>

              <button
                type="submit"
                class="px-4 py-2 bg-primary hover:bg-primary-hover text-white text-xs font-semibold rounded-lg cursor-pointer transition-colors"
              >Assign User</button>
            </form>

            {{! Assignments list }}
            <div class="space-y-4">
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Active Assignments</h4>
              <div class="space-y-3">
                {{#each this.model.assignments as |assign|}}
                  <div
                    class="p-4 border border-border rounded-xl bg-card shadow-sm flex items-center justify-between"
                  >
                    <div>
                      <div class="flex items-center gap-2">
                        <span
                          class="text-sm font-bold text-text"
                        >{{assign.assignedToUser.fullName}}</span>
                        <span
                          class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase bg-gray-150 text-text-secondary bg-gray-100"
                        >
                          {{assign.assignmentType}}
                        </span>
                      </div>
                      <span
                        class="text-xs text-text-secondary block mt-1"
                      >Assigned by {{assign.assignedByUser.fullName}}</span>
                      {{#if assign.notes}}
                        <p
                          class="text-xs text-text-secondary italic mt-2"
                        >"{{assign.notes}}"</p>
                      {{/if}}
                    </div>

                    <div>
                      <span
                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium uppercase
                          {{if
                            (eq assign.status 'COMPLETED')
                            'bg-green-50 text-green-800'
                          }}
                          {{if
                            (eq assign.status 'IN_PROGRESS')
                            'bg-blue-50 text-blue-800'
                          }}
                          {{if
                            (eq assign.status 'PENDING')
                            'bg-gray-50 text-gray-800'
                          }}"
                      >
                        {{assign.status}}
                      </span>
                    </div>
                  </div>
                {{else}}
                  <p class="text-xs text-text-secondary italic">No team
                    assignments configured.</p>
                {{/each}}
              </div>
            </div>
          </div>
        {{/if}}

        {{#if (eq this.activeTab "tasks")}}
          <div class="space-y-6">
            {{! Checklist creation form }}
            <form
              class="p-5 border border-border bg-gray-50 rounded-xl space-y-4"
              {{on "submit" this.createChecklistItem}}
            >
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Create Checklist Item</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label
                    for="task-assign"
                    class="block text-xs text-text-secondary font-medium mb-1 font-sans"
                  >Under Assignment</label>
                  <select
                    id="task-assign"
                    required
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.selectedAssignmentIdForTask}}
                    {{on
                      "change"
                      (pick
                        "target.value" (mut this.selectedAssignmentIdForTask)
                      )
                    }}
                  >
                    <option value="">Select Assignment...</option>
                    {{#each this.model.assignments as |assign|}}
                      <option
                        value={{assign.id}}
                      >{{assign.assignedToUser.fullName}}
                        -
                        {{assign.assignmentType}}</option>
                    {{/each}}
                  </select>
                </div>

                <div>
                  <label
                    for="task-priority"
                    class="block text-xs text-text-secondary font-medium mb-1"
                  >Priority</label>
                  <select
                    id="task-priority"
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.newTaskPriority}}
                    {{on
                      "change"
                      (pick "target.value" (mut this.newTaskPriority))
                    }}
                  >
                    <option value="LOW">LOW</option>
                    <option value="MEDIUM">MEDIUM</option>
                    <option value="HIGH">HIGH</option>
                    <option value="URGENT">URGENT</option>
                  </select>
                </div>
              </div>

              <div>
                <label
                  for="task-title"
                  class="block text-xs text-text-secondary font-medium mb-1"
                >Checklist Task Title</label>
                <input
                  id="task-title"
                  type="text"
                  required
                  placeholder="e.g. Edit Visual B-Roll cuts"
                  class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                  value={{this.newTaskTitle}}
                  {{on "input" (pick "target.value" (mut this.newTaskTitle))}}
                />
              </div>

              <button
                type="submit"
                class="px-4 py-2 bg-primary hover:bg-primary-hover text-white text-xs font-semibold rounded-lg cursor-pointer transition-colors"
              >Add Item</button>
            </form>

            {{! Checklist table }}
            <div class="space-y-4">
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Tasks Checklist</h4>
              <div class="space-y-2">
                {{#each this.tasksList as |task|}}
                  <div
                    class="p-3.5 border border-border rounded-xl bg-card shadow-sm flex items-center justify-between hover:bg-gray-50/20 transition-all"
                  >
                    <div class="flex items-center gap-3">
                      <input
                        type="checkbox"
                        class="h-4 w-4 text-primary focus:ring-primary border-border rounded cursor-pointer"
                        checked={{eq task.status "DONE"}}
                        {{on "change" (fn this.toggleTaskStatus task)}}
                      />
                      <span
                        class="text-sm text-text font-medium
                          {{if
                            (eq task.status 'DONE')
                            'line-through text-text-secondary'
                          }}"
                      >
                        {{task.title}}
                      </span>
                    </div>

                    <div class="flex items-center gap-2">
                      <span
                        class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase
                          {{if
                            (eq task.priority 'URGENT')
                            'bg-red-50 text-red-700 border border-red-100'
                          }}
                          {{if
                            (eq task.priority 'HIGH')
                            'bg-orange-50 text-orange-700 border border-orange-100'
                          }}
                          {{if
                            (eq task.priority 'MEDIUM')
                            'bg-blue-50 text-blue-700 border border-blue-100'
                          }}
                          {{if
                            (eq task.priority 'LOW')
                            'bg-gray-50 text-gray-700 border border-gray-100'
                          }}"
                      >
                        {{task.priority}}
                      </span>
                    </div>
                  </div>
                {{else}}
                  <p class="text-xs text-text-secondary italic">No checklist
                    items registered.</p>
                {{/each}}
              </div>
            </div>
          </div>
        {{/if}}

        {{#if (eq this.activeTab "assets")}}
          <div class="space-y-6">
            {{! Add Asset Form }}
            <form
              class="p-5 border border-border bg-gray-50 rounded-xl space-y-4"
              {{on "submit" this.addAsset}}
            >
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Link Video Asset / Document</h4>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label
                    for="asset-type"
                    class="block text-xs text-text-secondary font-medium mb-1"
                  >Asset Category</label>
                  <select
                    id="asset-type"
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.newAssetType}}
                    {{on
                      "change"
                      (pick "target.value" (mut this.newAssetType))
                    }}
                  >
                    <option value="RAW_VIDEO">RAW VIDEO</option>
                    <option value="EDITED_VIDEO">EDITED VIDEO</option>
                    <option value="THUMBNAIL">THUMBNAIL</option>
                    <option value="OTHER">OTHER</option>
                  </select>
                </div>

                <div>
                  <label
                    for="asset-source"
                    class="block text-xs text-text-secondary font-medium mb-1"
                  >Cloud Source</label>
                  <select
                    id="asset-source"
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.newAssetSource}}
                    {{on
                      "change"
                      (pick "target.value" (mut this.newAssetSource))
                    }}
                  >
                    <option value="GOOGLE_DRIVE">GOOGLE DRIVE</option>
                    <option value="YOUTUBE">YOUTUBE</option>
                    <option value="OTHER">OTHER</option>
                  </select>
                </div>

                <div>
                  <label
                    for="asset-name"
                    class="block text-xs text-text-secondary font-medium mb-1"
                  >File Name</label>
                  <input
                    id="asset-name"
                    type="text"
                    required
                    placeholder="e.g. Final Edit V2"
                    class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                    value={{this.newAssetName}}
                    {{on "input" (pick "target.value" (mut this.newAssetName))}}
                  />
                </div>
              </div>

              <div>
                <label
                  for="asset-url"
                  class="block text-xs text-text-secondary font-medium mb-1"
                >Cloud Link URL</label>
                <input
                  id="asset-url"
                  type="url"
                  required
                  placeholder="https://drive.google.com/..."
                  class="w-full px-3 py-2 border border-border rounded-lg text-xs bg-background text-text focus:ring-1 focus:ring-primary outline-none"
                  value={{this.newAssetUrl}}
                  {{on "input" (pick "target.value" (mut this.newAssetUrl))}}
                />
              </div>

              <button
                type="submit"
                class="px-4 py-2 bg-primary hover:bg-primary-hover text-white text-xs font-semibold rounded-lg cursor-pointer transition-colors"
              >Register Asset</button>
            </form>

            {{! Assets list }}
            <div class="space-y-4">
              <h4
                class="font-bold text-xs text-text uppercase tracking-wider"
              >Registered Assets</h4>
              <div class="space-y-3">
                {{#each this.model.assets as |asset|}}
                  <div
                    class="p-4 border border-border rounded-xl bg-card shadow-sm flex items-center justify-between"
                  >
                    <div>
                      <div class="flex items-center gap-2">
                        <span
                          class="text-sm font-bold text-text"
                        >{{asset.name}}</span>
                        <span
                          class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase bg-gray-100 text-text-secondary"
                        >
                          {{asset.assetType}}
                        </span>
                      </div>
                      <span
                        class="text-xs text-text-secondary block mt-1"
                      >Source: {{asset.assetSource}}</span>
                    </div>

                    <a
                      href={{asset.fileUrl}}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-3.5 py-1.5 border border-border rounded-lg text-xs font-semibold text-text-secondary hover:bg-gray-50 transition-colors"
                    >
                      Open Asset Link
                    </a>
                  </div>
                {{else}}
                  <p class="text-xs text-text-secondary italic">No assets
                    registered.</p>
                {{/each}}
              </div>
            </div>
          </div>
        {{/if}}

        {{#if (eq this.activeTab "activity")}}
          <div class="space-y-4">
            <h4
              class="font-bold text-xs text-text uppercase tracking-wider"
            >Timeline Audit Trail</h4>
            <div
              class="relative border-l border-border pl-6 ml-3 space-y-6 py-2"
            >
              {{#each this.model.activities.content as |act|}}
                <div class="relative">
                  {{! Timeline point dot }}
                  <span
                    class="absolute -left-[30px] top-1.5 h-3.5 w-3.5 rounded-full border border-border bg-gray-200 block"
                  ></span>

                  <div class="flex flex-col">
                    <div class="flex items-center justify-between">
                      <span
                        class="text-xs font-bold text-text"
                      >{{act.description}}</span>
                      <span
                        class="text-[10px] text-text-secondary"
                      >{{act.occurredAt}}</span>
                    </div>
                    <span
                      class="text-[10px] text-text-secondary uppercase font-semibold mt-1 tracking-wide text-primary"
                    >
                      {{act.eventType}}
                    </span>
                  </div>
                </div>
              {{else}}
                <p class="text-xs text-text-secondary italic pl-2">No activity
                  events recorded yet.</p>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </div>

      {{! Right Panel: Side summary metadata (Fixed width) }}
      <aside
        class="w-80 border-l border-border p-8 bg-gray-50 flex flex-col justify-between flex-shrink-0 overflow-y-auto"
      >
        <div class="space-y-6">
          <h4
            class="font-bold text-xs text-text uppercase tracking-wider"
          >Metadata Summary</h4>

          <div class="space-y-4">
            <div>
              <span
                class="text-[10px] font-bold text-text-secondary uppercase tracking-wide block"
              >Current Stage</span>
              <span
                class="text-sm font-bold text-text block mt-1 uppercase"
              >{{this.model.content.stage}}</span>
            </div>

            <div>
              <span
                class="text-[10px] font-bold text-text-secondary uppercase tracking-wide block"
              >Urgency Priority</span>
              <span
                class="text-sm font-bold text-text block mt-1 uppercase"
              >{{this.model.content.priority}}</span>
            </div>

            <div>
              <span
                class="text-[10px] font-bold text-text-secondary uppercase tracking-wide block"
              >Expected Due Date</span>
              <span class="text-sm font-bold text-text block mt-1">
                {{#if this.model.content.dueDate}}
                  {{format-date this.model.content.dueDate}}
                {{else}}
                  Not Set
                {{/if}}
              </span>
            </div>

            <div>
              <span
                class="text-[10px] font-bold text-text-secondary uppercase tracking-wide block"
              >Publish Target</span>
              <span class="text-sm font-bold text-text block mt-1">
                {{#if this.model.content.publishDate}}
                  {{format-date this.model.content.publishDate}}
                {{else}}
                  Not Published
                {{/if}}
              </span>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-border mt-8 flex flex-col gap-2">
          <button
            type="button"
            class="w-full flex items-center justify-center gap-1.5 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-text font-semibold rounded-lg text-xs transition-colors cursor-pointer"
            {{on "click" this.closeModal}}
          >
            Close Details
          </button>
        </div>
      </aside>
    </div>
  </div>
</div>