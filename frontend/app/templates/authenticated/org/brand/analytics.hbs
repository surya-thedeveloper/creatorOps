<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-text">Workspace Analytics</h2>
    <p class="text-sm text-text-secondary mt-1">Operational summaries, content breakdown, and pipeline status logs.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Content Breakdown Card -->
    <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
      <h3 class="font-bold text-text text-sm mb-4">Content Formats</h3>
      <div class="space-y-3">
        <!-- Progress representation of formats -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-text-secondary mb-1">
            <span>YouTube Videos</span>
            <span>Active</span>
          </div>
          <div class="w-full bg-gray-150 h-2 bg-gray-200 rounded-full">
            <div class="bg-red-500 h-2 rounded-full" style="width: 65%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-semibold text-text-secondary mb-1">
            <span>Shorts & Reels</span>
            <span>Active</span>
          </div>
          <div class="w-full bg-gray-150 h-2 bg-gray-200 rounded-full">
            <div class="bg-pink-500 h-2 rounded-full" style="width: 45%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-semibold text-text-secondary mb-1">
            <span>Blogs / Articles</span>
            <span>Active</span>
          </div>
          <div class="w-full bg-gray-150 h-2 bg-gray-200 rounded-full">
            <div class="bg-blue-500 h-2 rounded-full" style="width: 30%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Publishing Schedule Status Card -->
    <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
      <h3 class="font-bold text-text text-sm mb-4">Pipeline Scheduling</h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between p-3 border border-border bg-gray-50 rounded-lg">
          <span class="text-xs text-text font-medium">Releasing this Week</span>
          <span class="text-sm font-bold text-indigo-600">3 items</span>
        </div>
        <div class="flex items-center justify-between p-3 border border-border bg-gray-50 rounded-lg">
          <span class="text-xs text-text font-medium">Releasing this Month</span>
          <span class="text-sm font-bold text-emerald-600">8 items</span>
        </div>
        <div class="flex items-center justify-between p-3 border border-border bg-gray-50 rounded-lg">
          <span class="text-xs text-text font-medium">Overdue Release Dates</span>
          <span class="text-sm font-bold text-red-600">1 item</span>
        </div>
      </div>
    </div>
  </div>
</div>
