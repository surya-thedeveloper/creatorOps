{{! UX-02: Calendar template connected to real backend data }}
<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-text">Content Release Calendar</h2>
    <p class="text-sm text-text-secondary mt-1">Scheduled and upcoming content
      publication dates.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {{! Upcoming & Scheduled Items List (Left/Main Panel) }}
    <div class="lg:col-span-2 space-y-4">

      {{! Overdue Items }}
      {{#if this.model.overdue.length}}
        <div class="bg-red-50 border border-red-200 rounded-xl p-5 shadow-sm">
          <h3
            class="font-bold text-red-800 text-sm mb-3 flex items-center gap-2"
          >
            <svg
              class="h-4 w-4 text-red-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            Overdue ({{this.model.overdue.length}})
          </h3>
          <div class="space-y-2">
            {{#each this.model.overdue as |content|}}
              <div
                class="bg-white border border-red-100 rounded-lg p-3 flex items-center justify-between"
              >
                <div>
                  <span
                    class="font-semibold text-xs text-text block"
                  >{{content.title}}</span>
                  <span
                    class="text-[10px] text-text-secondary block mt-0.5"
                  >Due: {{format-date content.dueDate}}</span>
                </div>
                <span
                  class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase bg-red-100 text-red-800"
                >{{content.stage}}</span>
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{! Scheduled Items Grid }}
      <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
        <h3 class="font-bold text-text text-sm mb-4">Scheduled This Month</h3>
        {{#if this.model.scheduled.length}}
          <div class="space-y-3">
            {{#each this.model.scheduled as |content|}}
              <div
                class="flex items-center justify-between p-3 border border-border rounded-lg bg-gray-50 hover:border-primary/30 transition-colors"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="h-8 w-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0"
                  >
                    <svg
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  </div>
                  <div>
                    <span
                      class="font-semibold text-xs text-text block"
                    >{{content.title}}</span>
                    <span class="text-[10px] text-text-secondary block mt-0.5">
                      <span
                        class="uppercase font-semibold"
                      >{{content.type}}</span>
                      {{#if content.publishDate}}
                        · Publishes
                        {{format-date content.publishDate}}
                      {{else if content.dueDate}}
                        · Due
                        {{format-date content.dueDate}}
                      {{/if}}
                    </span>
                  </div>
                </div>
                <span
                  class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wider uppercase bg-indigo-50 text-indigo-700 border border-indigo-100 flex-shrink-0"
                >{{content.stage}}</span>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div
            class="text-center py-10 text-xs text-text-secondary border border-dashed border-border rounded-lg"
          >
            <svg
              class="h-8 w-8 mx-auto text-text-secondary/50 mb-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            No scheduled content for this month.
          </div>
        {{/if}}
      </div>
    </div>

    {{! Sidebar: Upcoming Due Dates }}
    <div
      class="bg-card border border-border rounded-xl p-6 shadow-sm flex flex-col"
    >
      <h3 class="font-bold text-text text-sm mb-4">Upcoming Due Dates</h3>
      <div class="space-y-3 overflow-y-auto flex-grow">
        {{#each this.model.upcoming as |content|}}
          {{#if content.dueDate}}
            <div
              class="p-3 border border-border rounded-lg bg-gray-50 flex flex-col gap-1 hover:border-primary/50 transition-colors"
            >
              <div class="flex items-center justify-between">
                <span
                  class="text-[9px] font-bold tracking-wider px-1.5 py-0.5 rounded uppercase bg-primary/10 text-primary"
                >
                  {{content.type}}
                </span>
                <span class="text-[9px] text-text-secondary">{{format-date
                    content.dueDate
                    format="short"
                  }}</span>
              </div>
              <span
                class="font-bold text-xs text-text block mt-1"
              >{{content.title}}</span>
            </div>
          {{/if}}
        {{else}}
          <div
            class="text-center py-8 text-xs text-text-secondary border border-dashed border-border rounded-lg"
          >
            No upcoming items found.
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>