<div class="min-h-screen bg-gray-50 flex">
  {{! Sidebar Container }}
  <aside
    class="w-64 bg-card border-r border-border flex flex-col justify-between flex-shrink-0"
  >
    {{! Top Part of Sidebar }}
    <div class="flex flex-col">
      {{! Brand Logo / Header }}
      <div class="p-6 border-b border-border flex items-center gap-3">
        <div
          class="h-8 w-8 rounded-lg bg-primary flex items-center justify-center text-white font-bold text-lg"
        >
          C
        </div>
        <div>
          <span
            class="text-lg font-bold text-text block leading-none"
          >CreatorOps</span>
          <span
            class="text-xs text-text-secondary mt-0.5 block"
          >{{this.session.orgName}}</span>
        </div>
      </div>

      {{! Navigation Links }}
      <nav class="p-4 space-y-1.5 flex-grow">
        <LinkTo
          @route="authenticated.dashboard"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-text-secondary hover:bg-gray-100 hover:text-text"
          @activeClass="bg-primary/10 text-primary hover:bg-primary/10 hover:text-primary font-semibold"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z"
            />
          </svg>
          Dashboard
        </LinkTo>

        {{#if this.session.brandId}}
          <LinkTo
            @route="authenticated.org.brand.content"
            @models={{array this.session.orgId this.session.brandId}}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-text-secondary hover:bg-gray-100 hover:text-text"
            @activeClass="bg-primary/10 text-primary hover:bg-primary/10 hover:text-primary font-semibold"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              />
            </svg>
            Content Board
          </LinkTo>

          <LinkTo
            @route="authenticated.org.brand.calendar"
            @models={{array this.session.orgId this.session.brandId}}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-text-secondary hover:bg-gray-100 hover:text-text"
            @activeClass="bg-primary/10 text-primary hover:bg-primary/10 hover:text-primary font-semibold"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            Calendar
          </LinkTo>

          <LinkTo
            @route="authenticated.org.brand.team"
            @models={{array this.session.orgId this.session.brandId}}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-text-secondary hover:bg-gray-100 hover:text-text"
            @activeClass="bg-primary/10 text-primary hover:bg-primary/10 hover:text-primary font-semibold"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
              />
            </svg>
            Team Members
          </LinkTo>

          <LinkTo
            @route="authenticated.org.brand.analytics"
            @models={{array this.session.orgId this.session.brandId}}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-text-secondary hover:bg-gray-100 hover:text-text"
            @activeClass="bg-primary/10 text-primary hover:bg-primary/10 hover:text-primary font-semibold"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              />
            </svg>
            Analytics
          </LinkTo>

          <LinkTo
            @route="authenticated.org.brand.settings"
            @models={{array this.session.orgId this.session.brandId}}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-text-secondary hover:bg-gray-100 hover:text-text"
            @activeClass="bg-primary/10 text-primary hover:bg-primary/10 hover:text-primary font-semibold"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            Settings
          </LinkTo>
        {{/if}}
      </nav>
    </div>

    {{! Bottom Profile / Logout Part }}
    <div class="p-4 border-t border-border flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <div
          class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold"
        >
          {{this.userInitial}}
        </div>
        <div class="flex-grow min-w-0">
          <span
            class="text-sm font-semibold text-text block truncate"
          >{{this.session.userEmail}}</span>
          <span
            class="text-xs text-text-secondary capitalize block"
          >{{this.session.userRole}}</span>
        </div>
      </div>
      <button
        type="button"
        class="w-full flex items-center justify-center gap-2 px-3 py-2 border border-border rounded-lg text-sm text-text-secondary hover:bg-gray-50 hover:text-text transition-colors cursor-pointer"
        {{on "click" this.session.logout}}
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          />
        </svg>
        Sign out
      </button>
    </div>
  </aside>

  {{! Main Panel }}
  <main class="flex-grow flex flex-col min-w-0 h-screen overflow-hidden">
    {{! Top Header Bar }}
    <header
      class="h-16 bg-card border-b border-border flex items-center justify-between px-8 flex-shrink-0"
    >
      <div class="flex items-center gap-4">
        <h1 class="text-lg font-bold text-text">{{this.pageTitle}}</h1>
      </div>

      {{! Top Bar Actions }}
      <div class="flex items-center gap-4">
        {{! Search bar placeholder }}
        <div class="relative w-64">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3">
            <svg
              class="h-4 w-4 text-text-secondary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </span>
          <input
            type="text"
            placeholder="Search content..."
            class="w-full pl-9 pr-4 py-2 border border-border rounded-lg text-xs bg-gray-50 focus:ring-1 focus:ring-primary focus:bg-white transition-all outline-none"
          />
        </div>
      </div>
    </header>

    {{! Content Outlet (Scrollable wrapper) }}
    <div class="flex-grow overflow-y-auto p-8">
      {{outlet}}
    </div>
  </main>
</div>