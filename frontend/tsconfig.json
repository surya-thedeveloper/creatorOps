{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types"],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "frontend/tests/*": ["./tests/*"],
      "frontend/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types",
      "@types/ember-data__model",
      "@types/ember-data__store"
    ],
    "skipLibCheck": true
  }
}
